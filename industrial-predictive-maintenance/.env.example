# App Environment
ENV=development

# FastAPI
PORT=8000

# Redis Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL/TimescaleDB Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=factory_db
DB_USER=factory_user
DB_PASSWORD=secure_user_pass_123!
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=secure_admin_pass_123!

# AI Diagnostic Assistant Configuration
# Go to https://aistudio.google.com/ to get an API key
GEMINI_API_KEY=your_gemini_api_key_here
